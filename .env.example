# --- AI provider: defaults to Gemini, which is free (no credit card) ---
AI_PROVIDER=gemini

# Get this at https://aistudio.google.com -> "Get API key". Uses a Google
# account you already have. Free tier: ~1,500 requests/day, no billing
# required to start. This is enough for a real launch test.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Optional upgrade path: Anthropic Claude (paid, ~$0.003-0.005/recap) ---
# Only needed if you outgrow Gemini's free tier or want higher-quality
# recaps. Set AI_PROVIDER=anthropic to switch to this instead.
# Get a key at https://console.anthropic.com (Settings > API Keys) and add
# a small amount of prepaid credit under Settings > Billing — set a spend
# limit there too. Check https://docs.claude.com/en/docs/about-claude/models
# for the current cheapest model id if the default below is out of date.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Required: usage counter (free tier is plenty) ---
# Get these from https://console.upstash.com after creating a free Redis
# database. Use the "REST API" URL and token shown on the database page.
UPSTASH_REDIS_REST_URL=https://xxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Required: protects the /api/stats endpoint used for weekly check-ins ---
# Make up any long random password-like string here (letters/numbers, 20+ chars).
STATS_SECRET=change-me-to-something-long-and-random
